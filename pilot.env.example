# Copy to the ignored .env.pilot host file and supply high-entropy pilot credentials.
# This value is intentionally empty so the composition fails closed until configured.
INVOMATCH_SECURITY_SEED_TOKENS_JSON=

# Local composition validation may set false. A TLS-terminated pilot must use true.
INVOMATCH_SESSION_COOKIE_SECURE=true
INVOMATCH_SESSION_TTL_SECONDS=3600
INVOMATCH_PILOT_PORT=8080

# Build identity should be injected by the build/deployment process.
INVOMATCH_APPLICATION_VERSION=0.1.0
INVOMATCH_RELEASE_COMMIT_SHA=
INVOMATCH_RELEASE_BRANCH=
INVOMATCH_RELEASE_VALIDATION_STATUS=controlled_pilot

